# Provena-FLASK / PROVENA Trinity Environment Configuration
# Copy this file to .env and update values for your environment

# ──────────────────────────────────────────────────────────────────────────
# Flask Core
# ──────────────────────────────────────────────────────────────────────────

FLASK_ENV=development
FLASK_DEBUG=1

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# ──────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────

DATABASE_PATH=./data/provenance.db

# ──────────────────────────────────────────────────────────────────────────
# Cryptographic Keys
# ──────────────────────────────────────────────────────────────────────────

KEYS_DIR=./keys

# ──────────────────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────────────────

LOG_LEVEL=DEBUG

# ──────────────────────────────────────────────────────────────────────────
# API Configuration
# ──────────────────────────────────────────────────────────────────────────

MAX_CONTENT_LENGTH=33554432  # 32 MB

# ──────────────────────────────────────────────────────────────────────────
# PROVENA Trinity v2 — Watermarking
# ──────────────────────────────────────────────────────────────────────────

# 32-byte hex key for ChaCha20 CSPRNG (latent watermark pattern generation)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TRINITY_SECRET_KEY=4a6f736570687175657a6f6e6e6561626c656b657968657831323334

# Compute device: auto | cuda | cpu
DEVICE=auto

# Pixel watermark input image size (must match training config)
PIXEL_IMAGE_SIZE=256

# ──────────────────────────────────────────────────────────────────────────
# Model Paths (leave blank or pointing to missing files to run latent_only)
# ──────────────────────────────────────────────────────────────────────────

PIXEL_ENCODER_PATH=models/pixel_encoder.pth
PIXEL_DECODER_PATH=models/pixel_decoder.pth
CNN_CLASSIFIER_PATH=models/cnn_classifier.pth
VIT_DETECTOR_PATH=models/vit_detector.pth

# Allow app to start without trained weights (latent-only mode)
ALLOW_LATENT_ONLY_MODE=true

# ──────────────────────────────────────────────────────────────────────────
# Detection Thresholds
# ──────────────────────────────────────────────────────────────────────────

WATERMARK_CONFIDENCE_THRESHOLD=0.90
PHASH_MATCH_THRESHOLD=15
CNN_CONFIDENCE_THRESHOLD=0.80
VIT_CONFIDENCE_THRESHOLD=0.80
ENSEMBLE_THRESHOLD=0.75

# ──────────────────────────────────────────────────────────────────────────
# Model Download URLs (fill after training — see scripts/download_models.py)
# ──────────────────────────────────────────────────────────────────────────

# ENCODER_URL=
# DECODER_URL=
# CNN_URL=
# VIT_URL=
# ENCODER_GDRIVE_ID=
# DECODER_GDRIVE_ID=
# CNN_GDRIVE_ID=
# VIT_GDRIVE_ID=
